{
  "manifest_version": 3,
  "name": "Birdify",
  "version": "2.2.1",
  "description": "Bring back Twitter: bird logos, tab titles, headers, interface labels, Tweets and Retweets.",
  "homepage_url": "https://github.com/ExplodingCB/retwitterify-advanced",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Birdify",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": [
      "https://x.com/*", "https://www.x.com/*", "https://mobile.x.com/*",
      "https://twitter.com/*", "https://www.twitter.com/*", "https://mobile.twitter.com/*"
    ],
    "js": ["rules.js", "engine.js", "content.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["icons/bird.svg", "icons/bird-32.png", "icons/bird-192.png"],
    "matches": ["https://*.x.com/*", "https://*.twitter.com/*"]
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "retwitterify-advanced@local.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
